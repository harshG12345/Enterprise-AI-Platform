APP_NAME="Enterprise AI Platform"
APP_ENV="development"
DEBUG=true
LOG_LEVEL="INFO"
SECRET_KEY="super-secret-key-change-in-production-must-be-32-chars-long"
JWT_ALGORITHM="HS256"
JWT_EXPIRATION_MINUTES=60

DATABASE_URL="postgresql+asyncpg://postgres:postgres@localhost:5432/enterprise_ai"
DATABASE_URL_SYNC="postgresql+psycopg2://postgres:postgres@localhost:5432/enterprise_ai"
REDIS_URL="redis://localhost:6379/0"
MLFLOW_TRACKING_URI="http://localhost:5000"

UPLOAD_DIR="data/uploads"
MODEL_DIR="data/models"

CORS_ORIGINS=["http://localhost:5173", "http://localhost:3000", "http://127.0.0.1:5173"]
